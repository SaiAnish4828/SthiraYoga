{
  "name": "sthira-yoga-wellness",
  "private": true,
  "version": "1.0.0",
  "description": "Sthira Yoga & Wellness — yoga, therapy and mindful wellness website.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && GITHUB_PAGES=1 vite build --outDir docs",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "tsc -b",
    "smoke": "vite build --ssr scripts/ssr-smoke.tsx --outDir .smoke --logLevel error && node .smoke/ssr-smoke.js",
    "smoke:dom": "vite build --ssr scripts/dom-smoke.tsx --outDir .smoke --logLevel error && node .smoke/dom-smoke.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.0",
    "vite": "^8.2.2"
  }
}
